<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GraWKosci.MainPage"
             BackgroundColor="#F5F5DC">

    <!-- Rozkład wertykalny o kolorze tła Beige (#F5F5DC) -->
    <VerticalStackLayout Spacing="10" BackgroundColor="#F5F5DC">

        <!-- Napis z tytułem strony o tle Brown (#A52A2A) i białej czcionce -->
        <Label Text="Gra w kości. Autor 00000000000"
               TextColor="White"
               BackgroundColor="#A52A2A"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Padding="0,14"
               HorizontalOptions="FillAndExpand" />

        <!-- Przycisk RZUĆ KOŚĆMI w kolorze Chocolate (#D2691E) -->
        <Button Text="RZUĆ KOŚĆMI"
                Clicked="OnRollDiceClicked"
                BackgroundColor="#D2691E"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,10"
                Padding="25,8" />

        <!-- Rozkład horyzontalny o białym tle dla pięciu obrazów kości -->
        <HorizontalStackLayout BackgroundColor="White"
                               HorizontalOptions="Center"
                               Spacing="9"
                               Margin="0,10">
            <Image x:Name="imgKostka1" Source="question.jpg" HeightRequest="60" Margin="9" />
            <Image x:Name="imgKostka2" Source="question.jpg" HeightRequest="60" Margin="9" />
            <Image x:Name="imgKostka3" Source="question.jpg" HeightRequest="60" Margin="9" />
            <Image x:Name="imgKostka4" Source="question.jpg" HeightRequest="60" Margin="9" />
            <Image x:Name="imgKostka5" Source="question.jpg" HeightRequest="60" Margin="9" />
        </HorizontalStackLayout>

        <!-- Etykieta wyniku losowania -->
        <Label x:Name="lblRollResult"
               Text="Wynik tego losowania: 0"
               FontSize="16"
               HorizontalOptions="Center"
               Margin="0,10" />

        <!-- Etykieta wyniku całej gry -->
        <Label x:Name="lblGameResult"
               Text="Wynik gry: 0"
               FontSize="16"
               HorizontalOptions="Center"
               Margin="0,10" />

        <!-- Przycisk RESETUJ WYNIK w kolorze Chocolate (#D2691E) -->
        <Button Text="RESETUJ WYNIK"
                Clicked="OnResetClicked"
                BackgroundColor="#D2691E"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,10"
                Padding="25,8" />

    </VerticalStackLayout>
</ContentPage>
